{
	"$defs": {
		"AiUseDisclosureInfo": {
			"type": "object",
			"required": ["message", "disclosure_type"],
			"additionalProperties": false,
			"properties": {
				"message": {
					"type": "string"
				},
				"disclosure_type": {
					"type": "string",
					"enum": ["no_ai_usage", "ai_usage", "runtime_ai_usage"]
				}
			}
		},
		"CompatibilityInfo": {
			"type": "object",
			"required": ["EA", "EXP", "Controller"],
			"properties": {
				"EA": {
					"$ref": "#/$defs/Compatibility"
				},
				"EXP": {
					"$ref": "#/$defs/Compatibility"
				},
				"Controller": {
					"$ref": "#/$defs/ControllerCompatibility"
				}
			}
		},
		"Compatibility": {
			"type": "object",
			"required": ["state", "note"],
			"properties": {
				"state": {
					"type": "string",
					"enum": ["Works", "Damaged", "Broken"]
				},
				"note": {
					"type": "string"
				}
			}
		},
		"ControllerCompatibility": {
			"type": "object",
			"required": ["state", "note"],
			"properties": {
				"state": {
					"type": "string",
					"enum": [
						"Untested",
						"Unsupported",
						"Partial",
						"Implicit",
						"Supported"
					]
				},
				"note": {
					"type": "string"
				}
			}
		},
		"LatestVersion": {
			"oneOf": [
				{
					"type": "null"
				},
				{
					"type": "object",
					"required": ["id"],
					"additionalProperties": false,
					"properties": {
						"id": {
							"$ref": "defs#/$defs/id"
						}
					}
				}
			]
		},
		"Mod": {
			"type": "object",
			"required": ["id"],
			"properties": {
				"id": {
					"$ref": "defs#/$defs/id"
				},
				"name": {
					"type": "string",
					"minLength": 1
				},
				"short_description": {
					"type": "string"
				},
				"full_description": {
					"type": "string"
				},
				"source_url": {
					"oneOf": [
						{
							"type": "string",
							"const": ""
						},
						{
							"type": "string",
							"pattern": "^https:\\/\\/"
						}
					]
				},
				"creator_id": {
					"$ref": "defs#/$defs/id"
				},
				"approved": {
					"type": "boolean"
				},
				"views": {
					"type": "integer",
					"minimum": 0
				},
				"downloads": {
					"type": "integer",
					"minimum": 0
				},
				"hotness": {
					"type": "integer",
					"minimum": 0
				},
				"popularity": {
					"type": "integer",
					"minimum": 0
				},
				"updated_at": {
					"$ref": "defs#/$defs/datetime"
				},
				"created_at": {
					"$ref": "defs#/$defs/datetime"
				},
				"last_version_date": {
					"$ref": "defs#/$defs/datetime"
				},
				"mod_reference": {
					"type": "string",
					"minLength": 1
				},
				"hidden": {
					"type": "boolean"
				},
				"tags": {
					"type": "array",
					"items": {
						"type": "object",
						"required": ["id"],
						"additionalProperties": false,
						"properties": {
							"id": {
								"$ref": "defs#/$defs/id"
							}
						}
					}
				},
				"compatibility": {
					"oneOf": [
						{
							"$ref": "#/$defs/CompatibilityInfo"
						},
						{
							"type": "null"
						}
					]
				},
				"network_use_disclosure": {
					"oneOf": [
						{
							"type": "string"
						},
						{
							"type": "null"
						}
					]
				},
				"ai_use_disclosure": {
					"oneOf": [
						{
							"$ref": "#/$defs/AiUseDisclosureInfo"
						},
						{
							"type": "null"
						}
					]
				},
				"toggle_explicit_content": {
					"type": "boolean"
				},
				"authors": {
					"type": "array",
					"minItems": 1,
					"items": {
						"type": "object",
						"required": ["user_id", "role"],
						"additionalProperties": false,
						"properties": {
							"user_id": {
								"$ref": "defs#/$defs/id"
							},
							"role": {
								"type": "string"
							}
						}
					}
				},
				"versions": {
					"type": "array",
					"minItems": 0,
					"items": {
						"type": "object",
						"required": ["id"],
						"properties": {
							"id": {
								"$ref": "defs#/$defs/id"
							}
						}
					}
				},
				"latestVersions": {
					"type": "object",
					"required": ["alpha", "beta", "release"],
					"additionalProperties": false,
					"properties": {
						"alpha": {
							"$ref": "#/$defs/LatestVersion"
						},
						"beta": {
							"$ref": "#/$defs/LatestVersion"
						},
						"release": {
							"$ref": "#/$defs/LatestVersion"
						}
					}
				}
			}
		},
		"HasLogo": {
			"type": "object",
			"required": ["logo", "logo_thumbhash"],
			"properties": {
				"logo": {
					"type": "string",
					"pattern": "^https:\\/\\/storage\\.ficsit\\.app\\/file\\/smr-prod(-s3)?\\/images\\/mods\\/[A-Za-z0-9]+\\/logo\\.webp$"
				},
				"logo_thumbhash": {
					"type": "string",
					"pattern": "^[A-Za-z0-9+/=]+$"
				}
			}
		},
		"HasLogoBorked": {
			"type": "object",
			"required": ["logo", "logo_thumbhash"],
			"properties": {
				"logo": {
					"type": "string",
					"pattern": "^https:\\/\\/storage\\.ficsit\\.app\\/file\\/smr-prod(-s3)?\\/images\\/mods\\/[A-Za-z0-9]+\\/logo\\.webp$"
				},
				"logo_thumbhash": {
					"type": "string",
					"const": ""
				}
			}
		},
		"NoHasLogo": {
			"type": "object",
			"required": ["logo", "logo_thumbhash"],
			"properties": {
				"logo": {
					"type": "string",
					"const": ""
				},
				"logo_thumbhash": {
					"type": "string",
					"const": ""
				}
			}
		}
	},
	"type": "object",
	"required": ["data"],
	"additionalProperties": false,
	"properties": {
		"data": {
			"type": "object",
			"required": ["getMods"],
			"additionalProperties": false,
			"properties": {
				"getMods": {
					"type": "object",
					"required": ["mods"],
					"additionalProperties": false,
					"properties": {
						"mods": {
							"type": "array",
							"items": {
								"type": "object",
								"unevaluatedProperties": false,
								"allOf": [
									{
										"$ref": "#/$defs/Mod"
									},
									{
										"oneOf": [
											{
												"$ref": "#/$defs/HasLogo"
											},
											{
												"$ref": "#/$defs/HasLogoBorked"
											},
											{
												"$ref": "#/$defs/NoHasLogo"
											}
										]
									}
								]
							}
						}
					}
				}
			}
		}
	}
}
